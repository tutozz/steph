{
  "meta": {
    "source": "docs/design/source/charte.dc.html",
    "version": "charte v1, 2026-09-28",
    "theme": "dark-only"
  },
  "color": {
    "black": "#0b0b0b",
    "offwhite": "#f4f4f0",
    "lemon": "#e2ff3b",
    "lemon_pressed": "#c3dc2a",
    "block": "#262626",
    "surface": "#161616",
    "code_bg": "#1f1f1f",
    "grid": "#1a1a1a",
    "text_muted": "#cfcfca",
    "text_soft": "#e6e6e1",
    "chart_neutral": "#8a8a85",
    "chart_gridline": "#2a2a28",
    "stroke": "#77776f",
    "stroke_deco": "#3a3a37",
    "hatch_lemon": "#3d4410",
    "hatch_neutral": "#3a3a37",
    "section_light_bg": "#f4f4f0",
    "section_light_text": "#0b0b0b",
    "section_light_text_soft": "#2e2e2b"
  },
  "font": {
    "brand": "Space Grotesk",
    "code": "JetBrains Mono",
    "brand_weights": [400, 500, 700],
    "code_weights": [400, 500, 600],
    "google_fonts_url": "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
  },
  "type_scale_px": {
    "h1": {"max": 136, "min": 60, "leading": 0.92, "tracking_em": -0.05, "weight": 500},
    "h2": {"max": 76, "min": 40, "leading": 0.98, "tracking_em": -0.04, "weight": 500},
    "figure": {"max": 168, "min": 88, "leading": 0.85, "tracking_em": -0.06, "weight": 500},
    "h3": {"max": 38, "min": 26, "leading": 1.15, "tracking_em": -0.02, "weight": 500},
    "quote": {"max": 36, "min": 24, "leading": 1.2, "tracking_em": -0.02, "weight": 500},
    "body": {"max": 23, "min": 20, "leading": 1.5, "tracking_em": 0, "weight": 400},
    "eyebrow": {"size": 20, "leading": 1.45, "font": "code", "weight": 500},
    "caption_min": {"size": 19, "leading": 1.5, "weight": 400}
  },
  "space_px": {
    "pixel": 32,
    "page_max": 1440,
    "gutter_page_min": 19,
    "gutter_page_max": 64,
    "section_pad_min": 64,
    "section_pad_max": 112,
    "gap": 16,
    "card_pad": 28,
    "notch_button": 6,
    "notch_card": 8,
    "radius": 0,
    "target_min": 44
  },
  "motion_ms": {
    "short": 100,
    "long": 200,
    "copied_hold": 2000,
    "easing": "ease-out",
    "reduced": 0
  },
  "chart": {
    "background": "#161616",
    "frame": "#3a3a37",
    "frame_width_px": 2,
    "winner": "#e2ff3b",
    "other": "#8a8a85",
    "axis": "#8a8a85",
    "axis_width_px": 2,
    "gridline": "#2a2a28",
    "gridline_width_px": 1,
    "point": "#f4f4f0",
    "point_size_px": 18,
    "point_shape": "square",
    "title": {"font": "brand", "weight": 500, "size_px": 34, "color": "#f4f4f0"},
    "subtitle": {"font": "brand", "weight": 400, "size_px": 20, "color": "#cfcfca"},
    "category_label": {"font": "brand", "weight": 400, "size_px": 19, "color": "#f4f4f0", "position": "above_bar"},
    "winner_label": {"font": "code", "weight": 700, "size_px": 19, "color": "#e2ff3b"},
    "value_label": {"font": "code", "weight": 600, "size_px": 19, "color": "#f4f4f0", "position": "right_of_bar", "decimal_separator": ","},
    "tick_label": {"font": "code", "weight": 400, "size_px": 19, "color": "#cfcfca"},
    "bar_height_px": {"single": 32, "paired": 36, "small_multiples": 24},
    "pending_bar": {"border": "2px dashed", "fill": "hatch 135deg 6px", "width_ratio": 0.45, "label": "à remplir"},
    "forbidden": ["pie", "3d", "log_scale", "non_zero_baseline"]
  }
}
