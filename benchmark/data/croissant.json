 "rai:dataCollection": "Real cases: outputs captured on the author's own Linux and macOS machines while developing a talking terminal, then anonymized by hand. Synthetic cases: written for the benchmark to look like the real tools, generated deterministically.",
 "rai:dataCollectionType": [
  "Manual Human Curation",
  "Software Collection",
  "Synthetic Data"
 ],
 "rai:dataCollectionTimeframe": [
  "2026-09-01",
  "2026-09-27"
 ],
 "rai:dataCollectionRawData": "Terminal outputs of standard command-line tools (compilers, git, package managers, network and disk tools, container tools, test runners).",
 "rai:dataPreprocessingProtocol": "Anonymization: user, host and project names replaced; LAN, VPN and public addresses remapped to private or documentation ranges; MAC addresses, UUIDs, serial numbers and IPv6 interface identifiers removed. Every case passes an automated PII scanner with zero findings.",
 "rai:dataAnnotationProtocol": "Each case carries expected facts (regular expressions), forbidden content and a reference answer, written by the author and checked automatically: the reference scores 100 %, every number it states appears in the model input, patterns are accent-free.",
 "rai:dataAnnotationPlatform": "Plain text editor and the benchmark's own build checks.",
 "rai:annotationsPerItem": "1",
 "rai:dataUseCases": [
  "Evaluation of LLMs and prompts for spoken terminal assistance. The test split is for evaluation only; the dev split may be used for tuning."
 ],
 "rai:dataLimitations": "105 cases per language; regex scoring rewards stated facts and can miss a correct paraphrase or a subtle hallucination; outputs cover common Linux and macOS tools, not Windows; references reflect one author's notion of a useful summary.",
 "rai:dataBiases": "Tool mix follows a developer and home-server workflow; six languages (en, fr, de, es, pt, ru), most other languages absent; synthetic outputs may be cleaner than real ones; for de/es/pt/ru most tool outputs stay English/French (untranslated by the tool itself, see docs/research-terminal-languages.md), only the expected facts and reference answer are translated, plus a handful of genuine new-language tool captures (apt, git, df, du, ls).",
 "rai:personalSensitiveInformation": "None. Real outputs were anonymized and scanned.",
 "rai:dataSocialImpact": "Aims to improve accessibility of command-line work for blind and visually impaired people by making local, private assistants measurable.",
 "rai:dataReleaseMaintenancePlan": "Versioned directories (data/v1, v2...). A released version is never edited in place; fixes ship as a new version with a changelog."
}
